[Unit]
Description=Biograph shell history sensor (bash & zsh)
Documentation=https://github.com/domschl/Biograph
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/biograph-sensor-shell
Restart=on-failure
RestartSec=10s
# Increase if you have very high shell activity
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
