<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.biograph.sensor.kindle</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Change to the absolute path of your bio executable if not in PATH, e.g. /Users/username/.local/bin/bio -->
        <string>bio</string>
        <string>kindle</string>
        <string>/Volumes/Kindle</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>/Volumes/Kindle/documents/My Clippings.txt</string>
        <string>/Volumes/Kindle/My Clippings.txt</string>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/biograph-kindle.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/biograph-kindle.log</string>
</dict>
</plist>
