# Maintainer: Dominik Schloesser
pkgname=biograph-sensor-zsh
pkgver=0.1.1
pkgrel=1
pkgdesc="Biograph zsh history sensor — watches ~/.zsh_history and sends events"
arch=('any')
url="https://github.com/domschl/Biograph"
license=('MIT')
depends=('python' 'python-watchdog' 'python-httpx')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel' 'git')
source=("git+https://github.com/domschl/Biograph.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/biograph/sensors/zsh"
  grep -m 1 "^version" pyproject.toml | cut -d '"' -f 2
}

build() {
  cd "${srcdir}/biograph/sensors/zsh"
  rm -rf dist
  /usr/bin/python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/biograph/sensors/zsh"
  /usr/bin/python -m installer --destdir="${pkgdir}" dist/*.whl

  # Customise the systemd user service to point to the system-wide executable rather than local path
  sed -i 's|%h/.local/bin/biograph-sensor-zsh|/usr/bin/biograph-sensor-zsh|g' biograph-zsh.service
  install -Dm644 biograph-zsh.service "${pkgdir}/usr/lib/systemd/user/biograph-zsh.service"
}
