# Maintainer: Dominik Schloesser <domschl@codeberg.org>
pkgname=biograph-cli
pkgver=0.1.0
pkgrel=1
pkgdesc="Biograph command-line logger and query tool (bio CLI)"
arch=('any')
url="https://codeberg.org/domschl/biograph"
license=('MIT')
depends=('python' 'python-typer' 'python-httpx' 'python-rich')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel' 'git')
source=("git+https://codeberg.org/domschl/biograph.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/biograph/sensors/cli"
  grep -m 1 "^version" pyproject.toml | cut -d '"' -f 2
}

build() {
  cd "${srcdir}/biograph/sensors/cli"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/biograph/sensors/cli"
  python -m installer --destdir="${pkgdir}" dist/*.whl
}
