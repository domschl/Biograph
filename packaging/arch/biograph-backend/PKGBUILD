# Maintainer: Dominik Schloesser
pkgname=biograph-backend
pkgver=0.2.4
pkgrel=1
pkgdesc="Biograph personal life-logging backend (FastAPI + SQLite)"
arch=('any')
url="https://github.com/domschl/Biograph"
license=('MIT')
depends=('python' 'python-fastapi' 'python-sqlmodel' 'python-aiosqlite' 'python-alembic' 'python-greenlet')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-wheel' 'git')
source=("git+https://github.com/domschl/Biograph.git")
sha256sums=('SKIP')

backup=('etc/biograph/config.toml')
install=biograph-backend.install

_sync_local() {
  if [[ -d "${startdir}/../../../backend" ]]; then
    mkdir -p "${srcdir}/Biograph"
    rm -rf "${srcdir}/Biograph/backend" "${srcdir}/Biograph/web-client"
    cp -r "${startdir}/../../../backend" "${srcdir}/Biograph/"
    cp -r "${startdir}/../../../web-client" "${srcdir}/Biograph/"
    cp "${startdir}/../../../VERSION" "${srcdir}/Biograph/VERSION" 2>/dev/null || true
  fi
}

pkgver() {
  _sync_local
  if [[ -f "${srcdir}/Biograph/VERSION" ]]; then
    tr -d ' \n\r' < "${srcdir}/Biograph/VERSION"
  else
    cd "${srcdir}/Biograph/backend"
    grep -m 1 "^version" pyproject.toml | cut -d '"' -f 2
  fi
}

build() {
  _sync_local
  cd "${srcdir}/Biograph/backend"
  rm -rf dist
  /usr/bin/python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/Biograph/backend"
  /usr/bin/python -m installer --destdir="${pkgdir}" dist/*.whl

  # Install web client static assets
  install -d "${pkgdir}/usr/share/biograph/web-client"
  cp -r "${srcdir}/Biograph/web-client/"* "${pkgdir}/usr/share/biograph/web-client/"

  # Install systemd service and sysusers configuration
  install -Dm644 biograph-backend.service "${pkgdir}/usr/lib/systemd/system/biograph-backend.service"
  install -Dm644 biograph-backend.sysusers "${pkgdir}/usr/lib/sysusers.d/biograph-backend.conf"

  # Install default configuration
  if [[ -f "${startdir}/../../../config.example.toml" ]]; then
    install -Dm640 "${startdir}/../../../config.example.toml" "${pkgdir}/etc/biograph/config.toml"
  else
    install -Dm640 "${srcdir}/Biograph/config.example.toml" "${pkgdir}/etc/biograph/config.toml"
  fi
}
